    <isExposed>true</isExposed>
    <masterLabel>A09-02 Assignment overview</masterLabel>
    <description>PROTOTYPE | A09-02 | Opening tiles and the two ways to continue, for the guide assignment flow.</description>
    <targets>
        <target>lightning__FlowScreen</target>
