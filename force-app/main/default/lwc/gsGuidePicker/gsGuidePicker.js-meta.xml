<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>A09-02 Guide picker</masterLabel>
    <description>PROTOTYPE | A09-02 | Candidate guides as cards for one group, with the reason for each gap.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="choices" type="apex://GS_AssignChoice[]" role="inputOnly" label="Candidates"/>
            <property name="headerText" type="String" role="inputOnly" label="Group and time"/>
            <property name="current" type="Integer" role="inputOnly" label="Current group number"/>
            <property name="total" type="Integer" role="inputOnly" label="Groups to review"/>
            <property name="suggestedValue" type="String" role="inputOnly" label="Pre-selected staff Id, or SKIP"/>
            <property name="selectedValue" type="String" role="outputOnly" label="Selected staff Id, or SKIP"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>