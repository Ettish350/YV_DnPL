    <decisions>
        <name>Check_Participants_Changed</name>
        <label>Check Participants Changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Participants Not Changed</defaultConnectorLabel>
        <rules>
            <name>Participants_Were_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inParticipantsChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inNumberOfParticipants</leftValueReference>
                <operator>IsNull</operator>
