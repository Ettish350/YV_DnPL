    <formulas>
        <name>choose_desk_id_assignment</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Desk__c})), {!$Record.Desk__r.Id},
IF(NOT(ISBLANK({!get_donor_desk.Desk__r.Id})), {!get_donor_desk.Desk__r.Id},
&quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>choose_transaction_period</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.ScheduleType})=&quot;Custom&quot;, &quot;Custom&quot;,&quot;Monthly&quot;)</expression>
    </formulas>
    <formulas>
        <name>exchange_rate_to_ILS</name>
        <dataType>Number</dataType>
        <expression>IF(TEXT({!$Record.Currency__c})=&quot;ILS&quot;,1,
{!get_GC_Xchg_Rate.currentExchangeRate__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>exchange_rate_to_USD</name>
        <dataType>Number</dataType>
        <expression>IF(TEXT({!$Record.Currency__c})=&quot;ILS&quot;,{!get_USD_Xchg_Rate.currentExchangeRate__c},
{!get_GC_Xchg_Rate.currentExchangeRate__c}/{!get_USD_Xchg_Rate.currentExchangeRate__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>exchange_to_expected_total_amount</name>
        <dataType>Currency</dataType>
        <expression>IF(TEXT({!$Record.Currency__c})=&quot;ILS&quot;,{!$Record.Total_amount_in_original_currency__c}/{!get_USD_Xchg_Rate.currentExchangeRate__c},
{!$Record.Total_amount_in_original_currency__c}*{!get_GC_Xchg_Rate.currentExchangeRate__c}/{!get_USD_Xchg_Rate.currentExchangeRate__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>exchange_to_single_transaction_amount</name>
        <dataType>Number</dataType>
        <expression>IF(TEXT({!$Record.Currency__c})=&quot;ILS&quot;,{!$Record.Amount_in_Original_Currency__c}/{!get_USD_Xchg_Rate.currentExchangeRate__c},
{!$Record.Amount_in_Original_Currency__c}*{!get_GC_Xchg_Rate.currentExchangeRate__c}/{!get_USD_Xchg_Rate.currentExchangeRate__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fiscal_year_num</name>
        <dataType>Number</dataType>
        <expression>VALUE({!$Record.Fiscal_Year__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>IS_NEW</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>payment_method_selector</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!$Record.Payment_Method__c})), &quot;PayPal&quot;, TEXT({!$Record.Payment_Method__c}))</expression>
    </formulas>
    <formulas>
        <name>Transaction_day_formula</name>
        <dataType>String</dataType>
        <expression>TEXT(DAY({!$Record.EffectiveStartDate}))</expression>
    </formulas>
