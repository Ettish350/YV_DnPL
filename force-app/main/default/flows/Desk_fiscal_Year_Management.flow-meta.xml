    <decisions>
        <name>Check_if_Today_is_Fiscal_Year_Start</name>
        <label>Check if Today is Fiscal Year Start</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Create_Annual_Desk_Records</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsFiscalYearStart</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>create_new_fiscal_year_record</targetReference>
            </connector>
            <label>Yes – Create Annual Desk Records</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
