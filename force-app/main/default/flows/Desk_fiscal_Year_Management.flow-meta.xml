        <scale>0</scale>
    </formulas>
    <formulas>
        <name>IsFiscalYearStart</name>
        <dataType>Boolean</dataType>
        <expression>DAY(TODAY()) = 1 &amp;&amp; MONTH(TODAY()) = 1</expression>
    </formulas>
    <formulas>
        <name>varPreviousFiscalYear</name>
        <dataType>Number</dataType>
        <expression>YEAR(TODAY())-1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>VnewFiscalYear</name>
        <dataType>String</dataType>
