    <textTemplates>
        <name>Email_To_Account_Body_English</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;strong&gt;Dear {!Get_Master_Case_Details.Account.First_Last_Name__c},&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you for contacting us.&lt;/p&gt;&lt;p&gt;We would like to inform you that your inquiry requires the involvement of several professional teams within our organization. Accordingly, each matter will be handled by the relevant department, and separate updates will be provided for each topic as the process progresses.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;We are committed to delivering a complete and accurate response, and we will continue to update you throughout the process.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Kind regards,&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255); font-size: small; font-family: Arial, sans-serif; color: rgb(34, 34, 34);&quot;&gt;Yad Vashem&lt;/strong&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>Email_To_Account_Body_Hebrew</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p class=&quot;ql-direction-rtl&quot; style=&quot;direction: rtl; text-align: right;&quot;&gt;&lt;strong&gt;שלום {!Get_Master_Case_Details.Account.First_Last_Name__c},&lt;/strong&gt;&lt;/p&gt;&lt;p class=&quot;ql-direction-rtl&quot; style=&quot;direction: rtl; text-align: right;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p class=&quot;ql-direction-rtl&quot; style=&quot;direction: rtl; text-align: right;&quot;&gt;תודה שפנית אלינו.&lt;/p&gt;&lt;p class=&quot;ql-direction-rtl&quot; style=&quot;direction: rtl; text-align: right;&quot;&gt;ברצוננו לעדכן כי הפנייה שלכם דורשת טיפול של מספר גורמים מקצועיים שונים בארגון.&lt;/p&gt;&lt;p class=&quot;ql-direction-rtl&quot; style=&quot;direction: rtl; text-align: right;&quot;&gt;בהתאם לכך, כל נושא יטופל על־ידי הצוות המתאים, ותקבלו עדכונים נפרדים לכל חלק מהפנייה בהתאם להתקדמות הטיפול.&lt;/p&gt;&lt;p class=&quot;ql-direction-rtl&quot; style=&quot;direction: rtl; text-align: right;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p class=&quot;ql-direction-rtl&quot; style=&quot;direction: rtl; text-align: right;&quot;&gt;אנו פועלים לספק לכם מענה מלא ומדויק, ונמשיך לעדכן אתכם לאורך התהליך.&lt;/p&gt;&lt;p class=&quot;ql-direction-rtl&quot; style=&quot;direction: rtl; text-align: right;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p class=&quot;ql-direction-rtl&quot; style=&quot;direction: rtl; text-align: right;&quot;&gt;&lt;strong&gt;בברכה,&lt;/strong&gt;&lt;/p&gt;&lt;p class=&quot;ql-direction-rtl&quot; style=&quot;direction: rtl; text-align: right;&quot;&gt;&lt;strong&gt;יד ושם&lt;/strong&gt;&lt;/p&gt;</text>
