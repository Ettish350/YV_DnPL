<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <decisions>
        <name>is_start_date_Today</name>
        <label>is start date Today</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>start_date_is_today</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StartDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Today</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>get_related_transaction</targetReference>
            </connector>
            <label>start date is today</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>exchange_rate_to_ILS</name>
        <dataType>Number</dataType>
        <expression>IF(TEXT({!get_related_transaction.Currency__c})=&quot;ILS&quot;,1,
{!get_Gift_exchange_rate.currentExchangeRate__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>exchange_rate_to_USD</name>
        <dataType>Number</dataType>
        <expression>IF(TEXT({!get_related_transaction.Currency__c})=&quot;ILS&quot;,{!get_USD_exchange_Rate.currentExchangeRate__c},
{!get_Gift_exchange_rate.currentExchangeRate__c}/{!get_USD_exchange_Rate.currentExchangeRate__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>exchange_to_original_amount</name>
        <dataType>Currency</dataType>
        <expression>IF(TEXT({!get_related_transaction.Currency__c})=&quot;ILS&quot;,{!get_related_transaction.Amount_in_GT_Currency__c}/{!get_USD_exchange_Rate.currentExchangeRate__c},
{!get_related_transaction.Amount_in_GT_Currency__c}*{!get_Gift_exchange_rate.currentExchangeRate__c}/{!get_USD_exchange_Rate.currentExchangeRate__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>GC custom schedules - update exchange rate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>GC custom schedules - update exchange rate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>get_Gift_exchange_rate</name>
        <label>get Gift exchange rate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>update_gift_transaction</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>get_related_transaction.Currency__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Exchange_Rate__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_related_transaction</name>
        <label>get related transaction</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>get_USD_exchange_Rate</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>GiftCommitmentScheduleId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>GiftTransaction</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_USD_exchange_Rate</name>
        <label>get USD exchange Rate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>get_Gift_exchange_rate</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>key__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>USD</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Exchange_Rate__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>update_gift_transaction</name>
        <label>update gift transaction</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>get_related_transaction.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Conversion_Date__c</field>
            <value>
                <elementReference>get_USD_exchange_Rate.CreatedDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Exchange_Rate_to_ILS__c</field>
            <value>
                <elementReference>exchange_rate_to_ILS</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Exchange_Rate_to_USD__c</field>
            <value>
                <elementReference>exchange_rate_to_USD</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OriginalAmount</field>
            <value>
                <elementReference>exchange_to_original_amount</elementReference>
            </value>
        </inputAssignments>
        <object>GiftTransaction</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>is_start_date_Today</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>TransactionPeriod</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Custom</stringValue>
            </value>
        </filters>
        <object>GiftCommitmentSchedule</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-10-15</startDate>
            <startTime>21:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
</Flow>
