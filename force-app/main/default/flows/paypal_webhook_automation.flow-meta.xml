<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <environments>Default</environments>
    <formulas>
        <name>came_from_schedule</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record.Payment_Status__c}=&quot;completed&quot; &amp;&amp; NOT(ISBLANK({!get_related_transaction.GiftCommitmentId})), true, false)</expression>
    </formulas>
    <formulas>
        <name>choose_status</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Payment_Status__c}=&quot;completed&quot; &amp;&amp; NOT(ISBLANK({!get_related_transaction.GiftCommitmentId})), &quot;Unpaid&quot;,
IF({!$Record.Payment_Status__c}=&quot;completed&quot; &amp;&amp; ISBLANK({!get_related_transaction.GiftCommitmentId}), &quot;Paid&quot;,
IF({!$Record.Payment_Status__c}=&quot;denied&quot;, &quot;Failed&quot;,
IF({!$Record.Payment_Status__c}=&quot;failed&quot;, &quot;Failed&quot;,
IF({!$Record.Payment_Status__c}=&quot;void&quot;, &quot;Failed&quot;,
&quot;Unpaid&quot;)))))</expression>
    </formulas>
    <interviewLabel>paypal webhook automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>paypal webhook automation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>get_related_transaction</name>
        <label>get related transaction</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>update_related_transaction</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>GiftCommitmentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Gift_Commitment_ID__r.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Unpaid</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>GiftTransaction</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>update_related_transaction</name>
        <label>update related transaction</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>get_related_transaction.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Actual_payment_Clearance_System__c</field>
            <value>
                <elementReference>$Record.Amount__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Amount_in_GT_Currency__c</field>
            <value>
                <elementReference>get_related_transaction.GiftCommitment.Amount_in_Original_Currency__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Clearance_System__c</field>
            <value>
                <stringValue>PayPal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Conversion_Date__c</field>
            <value>
                <elementReference>$Record.CreatedDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Credit_Card_Brand_Code__c</field>
            <value>
                <elementReference>$Record.Card_Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Credit_Card_Number__c</field>
            <value>
                <elementReference>$Record.Card_Last_4__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Currency__c</field>
            <value>
                <elementReference>get_related_transaction.GiftCommitment.Currency__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Donation_Source__c</field>
            <value>
                <stringValue>Internet</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LastGatewayErrorMessage</field>
            <value>
                <elementReference>$Record.Error_Message__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PaymentMethod</field>
            <value>
                <elementReference>$Record.Payment_Method__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>choose_status</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TransactionDate</field>
            <value>
                <elementReference>$Record.CreatedDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Transaction_ID__c</field>
            <value>
                <elementReference>$Record.PayPal_Transaction_ID__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Voucher_ID__c</field>
            <value>
                <elementReference>$Record.Voucher_ID__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>came_from_schedule__c</field>
            <value>
                <elementReference>came_from_schedule</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>status_from_Clearance_System__c</field>
            <value>
                <elementReference>$Record.Payment_Status__c</elementReference>
            </value>
        </inputAssignments>
        <object>GiftTransaction</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>get_related_transaction</targetReference>
        </connector>
        <object>PayPal_Webhook__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
