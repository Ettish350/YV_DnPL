<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <assignments>
        <name>Add_Amount_to_Opportunity</name>
        <label>Add Amount to Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Desk_Fiscal_Year.Total_Counted_Opportunities__c</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Desk_Fiscal_Year.Yearly_Forecasted_Amount__c</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Amount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Desk_Fiscal_Year</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Opp_Amount</name>
        <label>Add Opp Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Desk_Fiscal_Year.Yearly_Forecasted_Amount__c</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Amount</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_new_amount</name>
        <label>Assign new amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Desk_Fiscal_Year.Yearly_Forecasted_Amount__c</assignToReference>
            <operator>Subtract</operator>
            <value>
                <elementReference>$Record__Prior.Amount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Desk_Fiscal_Year.Yearly_Forecasted_Amount__c</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Amount</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <customErrors>
        <name>Block_Change_On_Paid_Order</name>
        <label>Block Change On Paid Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>ההזמנה שולמה, לא ניתן לשנות את מספר הקבוצות או המשתתפים. יש לעדכן את הכמויות ידנית.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_if_Amount_changed</name>
        <label>Check if Amount changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Amount remained the same</defaultConnectorLabel>
        <rules>
            <name>Amount_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Prior_amount_was_empty</targetReference>
            </connector>
            <label>Amount Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Counts_changed</name>
        <label>Check if Counts changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Desk_Fiscal_Year</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Counts Not Changed</defaultConnectorLabel>
        <rules>
            <name>Groups_or_Participants_Changed</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NumberOfGroups__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NumberOfParticipants__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_if_Order_is_Paid</targetReference>
            </connector>
            <label>Groups or Participants Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_fiscal_year_found</name>
        <label>Check if fiscal year found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Desk Fiscal year</defaultConnectorLabel>
        <rules>
            <name>Found_Desk_Fiscal_Year</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Desk_Fiscal_Year</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Amount_to_Opportunity</targetReference>
            </connector>
            <label>Found Desk Fiscal Year</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Opportunity_is_New</name>
        <label>Check if Opportunity is New</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_if_Amount_changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Updated Opportunity</defaultConnectorLabel>
        <rules>
            <name>New_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_if_fiscal_year_found</targetReference>
            </connector>
            <label>New Opportunity</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Order_is_Paid</name>
        <label>Check if Order is Paid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Line_Quantities_and_Group_Participants</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Order Not Paid</defaultConnectorLabel>
        <rules>
            <name>Order_Is_Paid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PaymentStatus__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>שולם</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Block_Change_On_Paid_Order</targetReference>
            </connector>
            <label>Order Is Paid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Prior_amount_was_empty</name>
        <label>Prior amount was empty?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_new_amount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Prior value not empty</defaultConnectorLabel>
        <rules>
            <name>Prior_value_was_empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Amount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Opp_Amount</targetReference>
            </connector>
            <label>Prior value was empty</label>
        </rules>
    </decisions>
    <description>[01/09/2025] [Neev] [Jira KMXT-34] 
Flow that populates the field Total Counted Opportunities on Desk Fiscal Year &amp; the amount from Opps into the field &apos;Yearly Forecasted Amount&apos; based on the Opp amount
[22/11/2026] [Anna] [Jira YV20-233] [A01-05, A03-03] New version: when Number of Groups or Number of Participants changes on an existing order, a paid order is blocked with an error, otherwise the subflow Subflow_Update_Line_Quantities_And_Group_Participants updates the line quantities by pricing method and splits the participants over the groups.</description>
    <environments>Default</environments>
    <formulas>
        <name>fParticipantsChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.NumberOfParticipants__c})</expression>
    </formulas>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Opportunity After Create &amp; Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity After Create &amp; Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Desk_Fiscal_Year</name>
        <label>Get Desk Fiscal Year</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_Opportunity_is_New</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Desk__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Desk__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Desk_Fiscal_Year__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Desk_Fiscal_Year</name>
        <label>Update Desk Fiscal Year</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>Get_Desk_Fiscal_Year</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_if_Counts_changed</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Update_Line_Quantities_and_Group_Participants</name>
        <label>Update Line Quantities and Group Participants</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Desk_Fiscal_Year</targetReference>
        </connector>
        <flowName>Subflow_Update_Line_Quantities_And_Group_Participants</flowName>
        <inputAssignments>
            <name>inNumberOfGroups</name>
            <value>
                <elementReference>$Record.NumberOfGroups__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inNumberOfParticipants</name>
            <value>
                <elementReference>$Record.NumberOfParticipants__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inOpportunityId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>inParticipantsChanged</name>
            <value>
                <elementReference>fParticipantsChanged</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
