<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <assignments>
        <name>Assign_Default_Desk_Israel</name>
        <label>Assign Default Desk Israel</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Desk__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Israel_Default_Account.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Deceased_is_Checked</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Desk_from_Created_by_user</name>
        <label>Assign Desk from Created by user</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Desk__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.CreatedBy.Desk__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Deceased_is_Checked</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Email_Opt_Out</name>
        <label>Assign Email Opt Out</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.PersonHasOptedOutOfEmail</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_if_Account_has_a_desk</name>
        <label>Check if Account has a desk</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Deceased_is_Checked</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Account has Desk</defaultConnectorLabel>
        <rules>
            <name>Account_doesn_t_have_Desk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Desk__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Desk_Recordtype</targetReference>
            </connector>
            <label>Account doesn&apos;t have Desk</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Account_is_new</name>
        <label>Check if Account is new</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Deceased_is_Checked</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Updated Account</defaultConnectorLabel>
        <rules>
            <name>New_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Type_of_Account</targetReference>
            </connector>
            <label>New Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_user_has_a_desk</name>
        <label>Check if user has a desk</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_if_Account_has_a_desk</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>User doesn&apos;t have a Desk</defaultConnectorLabel>
        <rules>
            <name>User_has_a_Desk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CreatedBy.Desk__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Desk_from_Created_by_user</targetReference>
            </connector>
            <label>User has a Desk</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if the user has checked the Deceased Checkbox to remove the deceased Account from sending email (Email Opt out)</description>
        <name>Deceased_is_Checked</name>
        <label>Deceased is Checked?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Deceased not checked</defaultConnectorLabel>
        <rules>
            <name>Deceased_Checked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Deceased__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Email_Opt_Out</targetReference>
            </connector>
            <label>Deceased Checked</label>
        </rules>
    </decisions>
    <decisions>
        <name>Found_Default_Israel_Account</name>
        <label>Found Default Israel Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Deceased_is_Checked</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Account found</defaultConnectorLabel>
        <rules>
            <name>Israel_Default_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Israel_Default_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Default_Desk_Israel</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Israel Default Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Type_of_Account</name>
        <label>Type of Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Deceased_is_Checked</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Is a Desk</defaultConnectorLabel>
        <rules>
            <name>Not_a_Desk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Desk</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_if_user_has_a_desk</targetReference>
            </connector>
            <label>Not a Desk</label>
        </rules>
    </decisions>
    <description>[02/09/2025] [Neev] - 
Assigning Desk to Account (not of type Desk) default Desk in case it does not have one initially 

[01/09/2025] [Neev] [Jira KMXT-31]
When a user checks the Deceased__c checkbox on a donor record, the flow automatically sets the Email Opt Out field to TRUE.</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Account Before Create &amp; Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Before Create &amp; Update</label>
