<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <environments>Default</environments>
    <formulas>
        <name>CurrentYear</name>
        <dataType>Number</dataType>
        <expression>YEAR(TODAY())</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>VnewBudgetAllocated</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Desk_fiscal_Year.Budget_Allocated__c} + {!$Record.BudgetedCost}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>VnewBudgetSpent</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Desk_fiscal_Year.Budget_Spent_del__c} + {!$Record.ActualCost}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>VNewCampaignsAmount</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Desk_fiscal_Year.Campaigns_Amount__c}+{!$Record.AmountWonOpportunities}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>VnewCampaignsCount</name>
        <dataType>Number</dataType>
        <expression>{!Get_Desk_fiscal_Year.Campaigns_Count__c}+1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Campaign Update Desk Fiscal Year {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Campaign Update Desk Fiscal Year</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Desk_fiscal_Year</name>
        <label>Get Desk fiscal Year</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_DFY</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Fiscal_Year__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Campaign_Year__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Desk__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Desk_Event__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Desk_Fiscal_Year__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_DFY</name>
        <label>Update DFY</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Desk_fiscal_Year.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Budget_Allocated__c</field>
            <value>
                <elementReference>VnewBudgetAllocated</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Budget_Spent_del__c</field>
            <value>
                <elementReference>VnewBudgetSpent</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Campaigns_Amount__c</field>
            <value>
                <elementReference>VNewCampaignsAmount</elementReference>
            </value>
        </inputAssignments>
        <object>Desk_Fiscal_Year__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Desk_fiscal_Year</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Aborted</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Campaign</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
