            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>B25__Reservation_Status__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Room_Without_Refreshments</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK({!$Record.B25__Resource__c}))
&amp;&amp; (
  (ISNEW() &amp;&amp; (
    {!$Record.Need_Refreshments__c} || {!$Record.Need_Arrangement__c}
    || (TEXT({!$User.UserType}) = &quot;Standard&quot; &amp;&amp; NOT({!$Permission.P11_Data_Load_Bypass}) &amp;&amp; ISBLANK({!$Record.Split_Parent__c}) &amp;&amp; TEXT({!$Record.Booking_Kind__c}) &lt;&gt; &quot;סגירה לפעילות פרטית&quot;)
  ))
  || (NOT(ISNEW())
    &amp;&amp; ({!$Record.Need_Refreshments__c} || {!$Record.Need_Arrangement__c})
    &amp;&amp; (ISCHANGED({!$Record.Need_Refreshments__c}) || ISCHANGED({!$Record.Need_Arrangement__c}) || ISCHANGED({!$Record.B25__Resource__c})))
)</filterFormula>
        <object>B25__Reservation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
