    <actionCalls>
        <description>Retrieves all the possible reservation collections (parent-child combinations) for the given blueprint.
If your blueprints have (staff) fields with &quot;available at parent resource&quot;, make sure to include the MDA date range, which is used to check actual availability.</description>
        <name>get_blueprint_collections</name>
        <label>get blueprint collections</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>B25__ReservationBlueprints</actionName>
