    <actionCalls>
        <description>Checks input collections for conflicts, and returns slots with collections that do not have conflicts.</description>
        <name>get_time_slots</name>
        <label>get time slots</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>B25__ReservationCollectionTimeSlotFinder</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>pick_a_slot</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>collectionsToCheck</name>
            <value>
                <elementReference>get_blueprint_collections.collections</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>timeSlotConfig</name>
            <value>
                <elementReference>timeSlotConfig</elementReference>
            </value>
        </inputParameters>
        <nameSegment>B25__ReservationCollectionTimeSlotFinder</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <assignments>
        <name>move_range_left</name>
        <label>move range left</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>timeSlotConfig.dateRange.offsetDays</assignToReference>
            <operator>Subtract</operator>
            <value>
                <elementReference>timeSlotConfig.dateRange.durationDays</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>get_time_slots</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>move_range_right</name>
        <label>move range right</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>timeSlotConfig.dateRange.offsetDays</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>timeSlotConfig.dateRange.durationDays</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>get_time_slots</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>set_inputs_for_endpoints</name>
        <label>set inputs for endpoints</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>timeSlotConfig.duration</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>slotDuration</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>prototypeReservation.B25__Resource__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>resourcePicklist</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>timeSlotConfig.dateRange.durationDays</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>14.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_blueprint_collections</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>slot_picker_outcome</name>
        <label>slot picker outcome</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>unexpected output from picker</defaultConnectorLabel>
        <rules>
            <name>slot_picked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>collection_picker.selectedTimeSlotWithReservationCollections</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>create_reservations</targetReference>
            </connector>
            <label>slot picked</label>
        </rules>
        <rules>
            <name>navigate_left</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>collection_picker.userNavPrev</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>collection_picker.selectedTimeSlotWithReservationCollections</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>move_range_left</targetReference>
            </connector>
            <label>navigate left</label>
        </rules>
        <rules>
            <name>navigate_right</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>collection_picker.userNavNext</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>collection_picker.selectedTimeSlotWithReservationCollections</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>move_range_right</targetReference>
            </connector>
            <label>navigate right</label>
        </rules>
    </decisions>
