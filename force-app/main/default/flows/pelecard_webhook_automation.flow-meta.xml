<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <decisions>
        <name>check_for_duplicate</name>
        <label>check for duplicate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>get_related_transaction</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Duplicate Not found</defaultConnectorLabel>
        <rules>
            <name>duplicate_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>try_to_find_duplicate.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>delete_created_file</targetReference>
            </connector>
            <label>duplicate found</label>
        </rules>
    </decisions>
    <decisions>
        <name>did_we_find_anything</name>
        <label>did we find anything</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>yes_we_found_one</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_related_transaction</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_transaction</targetReference>
            </connector>
            <label>yes - we found one</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>pelecard webhook automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>pelecard webhook automation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>delete_created_file</name>
        <label>delete created file</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>$Record</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>get_related_transaction</name>
        <label>get related transaction</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>did_we_find_anything</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DNE_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.DNE_Number__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>GiftTransaction</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>try_to_find_duplicate</name>
        <label>try to find duplicate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>check_for_duplicate</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Transaction_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Transaction_ID__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Broadcast_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Broadcast_Number__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Pelecard_Webhook__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>update_transaction</name>
        <label>update transaction</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>get_related_transaction.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Clearance_Broadcast_Number__c</field>
            <value>
                <elementReference>$Record.Broadcast_Number__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Credit_Card_Company_Clearer_Code__c</field>
            <value>
                <elementReference>$Record.Credit_Card_Clearer__c</elementReference>
            </value>
        </inputAssignments>
        <object>GiftTransaction</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>try_to_find_duplicate</targetReference>
        </connector>
        <object>Pelecard_Webhook__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
