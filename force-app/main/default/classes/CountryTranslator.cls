    /**
     * Static utility method — call from other Apex.
     *   String hebrew = CountryTranslator.toHebrew('T1129102'); // "איטליה"
     * Returns the original code unchanged if no match, or null for null input.
     */
    public static String toHebrew(String code) {
        if (code == null) return null;
        String trimmed = code.trim();
        if (trimmed == '') return trimmed;
        String hebrew = CODE_TO_HEBREW.get(trimmed);
        return (hebrew == null) ? trimmed : hebrew;
    }

    /**
     * Invocable version — call from Flow / Process Builder.
     * Input: list of country codes.
     * Output: list of Hebrew names in the same order.
     */
    @InvocableMethod(
        label='Translate Country Code to Hebrew'
        description='Given a country T-code (e.g. T1129102), returns the Hebrew country name.'
    )
    public static List<String> translateCodesToHebrew(List<String> codes) {
        List<String> out = new List<String>();
        if (codes == null) return out;
        for (String code : codes) {
            out.add(toHebrew(code));
        }
        return out;
    }

