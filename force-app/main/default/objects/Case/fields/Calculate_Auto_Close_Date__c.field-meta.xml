<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Calculate_Auto_Close_Date__c</fullName>
    <description>Auto Close Case After 6 Months from Creation Date (Status = New) – Yaatz Info</description>
    <formula>IF( CreatedDate +180&gt;=NOW(),TRUE,FALSE)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Calculate Auto Close Case</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
